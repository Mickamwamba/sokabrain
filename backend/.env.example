# Port for the API server (4000 is often taken; pick anything free).
PORT=4010

# Local Postgres (Postgres.app / Homebrew). Swap for a Neon/Railway URL when
# moving off-machine — nothing else in the app needs to change.
# Neon/Railway URLs additionally need ?sslmode=require
DATABASE_URL=postgresql://USER@127.0.0.1:5432/sokabrain

# Signing secret for admin JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# SportMonks Football API v3 token — THE live provider.
# Chosen because it is the only one whose Tanzanian Premier League event coverage
# could be verified before paying (league #884 "Ligi kuu Bara"). The plan in use
# also covers the Kenyan, Ugandan, Rwandan and South African top tiers.
# Without it the read and admin APIs work normally; only live-score sync is off.
SPORTMONKS_TOKEN=

# API-Football key. Kept wired as a fallback, but never validated against live
# data — its Tanzanian coverage is unknown (Cloudflare blocks the coverage page,
# and the flags sit behind a key). SPORTMONKS_TOKEN wins when both are set.
API_FOOTBALL_KEY=

# Live-score sync schedule. Every 2 minutes by default — frequent enough to feel
# live, and cheap: SportMonks' in-play feed answers in ONE request regardless of
# how many leagues the plan covers, against a 2000/hour limit.
LIVE_SYNC_CRON=*/2 * * * *
# Set to false to keep the scheduler off even when a key is present.
LIVE_SYNC_ENABLED=true
