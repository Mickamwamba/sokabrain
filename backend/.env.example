# Port for the API server (4000 is often taken; pick anything free).
PORT=4010

# Local Postgres (Postgres.app / Homebrew). Swap for a Neon/Railway URL when
# moving off-machine — nothing else in the app needs to change.
# Neon/Railway URLs additionally need ?sslmode=require
DATABASE_URL=postgresql://USER@127.0.0.1:5432/sokabrain

# Signing secret for admin JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# API-Football key (free tier is fine to validate league coverage first).
# Without it the read and admin APIs work normally; only live-score sync is off.
API_FOOTBALL_KEY=

# Live-score sync schedule. Every 2 minutes by default — frequent enough to feel
# live, cheap enough that a free-tier quota survives a matchday.
LIVE_SYNC_CRON=*/2 * * * *
# Set to false to keep the scheduler off even when a key is present.
LIVE_SYNC_ENABLED=true
