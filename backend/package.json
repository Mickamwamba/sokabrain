{
  "name": "sokabrain-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "seed:sources": "tsx src/scripts/seedSources.ts",
    "af:coverage": "tsx src/scripts/checkCoverage.ts",
    "af:map": "tsx src/scripts/mapApiFootball.ts",
    "af:sync": "tsx src/scripts/syncOnce.ts",
    "sm:coverage": "tsx src/scripts/checkSportmonksCoverage.ts",
    "sm:map": "tsx src/scripts/mapSportmonks.ts",
    "sm:compare": "tsx src/scripts/compareSportmonks.ts",
    "sm:sync": "tsx src/scripts/syncSportmonks.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
